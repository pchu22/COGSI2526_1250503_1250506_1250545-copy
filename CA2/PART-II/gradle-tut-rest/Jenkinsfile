pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                dir('CA2/PART-II/gradle-tut-rest') {
                    bat 'gradlew.bat bootRun'
                }
            }
        }

        stage('Test') {
            steps {
                dir('CA2/PART-II/gradle-tut-rest') {
                    bat 'gradlew.bat test'
                    junit 'build/test-results/test/*.xml'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('CA2/PART-II/gradle-tut-rest') {
                    bat 'gradlew.bat publish'
                }
            }
        }
    }
}